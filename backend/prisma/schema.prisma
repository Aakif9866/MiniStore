// Postgres holds facts ABOUT files. The bytes live in MinIO at (bucket, objectKey).
// Connection URL is in prisma.config.ts (Prisma 7 no longer reads it from here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  files        File[]

  @@map("users")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  originalName String   @map("original_name") // what the user called it; display only
  objectKey    String   @unique @map("object_key") // where the bytes are; generated by us
  bucket       String
  mimeType     String   @map("mime_type")
  size         BigInt // bytes. BigInt because Int (32-bit) caps at 2 GiB
  etag         String
  versionId    String?  @map("version_id") // null until bucket versioning (Phase 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // "List my files, newest first" is the hottest query — one index serves it.
  @@index([userId, createdAt])
  @@map("files")
}
