// Postgres holds facts ABOUT files. The bytes live in MinIO at (bucket, objectKey).
// Connection URL is in prisma.config.ts (Prisma 7 no longer reads it from here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  files        File[]

  @@map("users")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  originalName String   @map("original_name") // what the user called it; display only
  objectKey    String   @unique @map("object_key") // where the bytes are; generated by us
  bucket       String
  mimeType     String   @map("mime_type")
  size         BigInt // bytes. BigInt because Int (32-bit) caps at 2 GiB
  etag         String
  versionId    String?  @map("version_id") // S3 version id of the CURRENT content
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // set = in the trash (Phase 7); purged after the retention period
  versions     FileVersion[]

  // "List my files, newest first" is the hottest query — one index serves it.
  @@index([userId, createdAt])
  @@index([deletedAt]) // the purge job scans for old trash
  @@map("files")
}

// Every stored version of a file's bytes (Phase 6). Postgres, not S3 listing, is the source of
// truth: it answers "what does this user store?" with one indexed query, and quota counts it.
model FileVersion {
  id        String   @id @default(uuid()) @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionId String   @map("version_id") // S3 version id; "null" for objects written before versioning
  size      BigInt
  etag      String
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fileId, versionId])
  @@index([fileId, createdAt])
  @@map("file_versions")
}
