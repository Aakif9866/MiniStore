# Copy to .env and replace every value:   cp .env.example .env
# .env is git-ignored. Only this example file is committed.
# Generate a secret with:  openssl rand -hex 20
# (hex avoids characters like @ : / that break the mc URLs in docker-compose.yml)

# --- Host ports (non-default to avoid collisions with other local services) ---
# Inside Docker, MinIO always listens on 9000 (API) and 9001 (Console).
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- MinIO root (admin) account ---
# Full control of MinIO. Used only by humans and the init job — never by the backend.
MINIO_ROOT_USER=ministore-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- Bucket the application stores files in ---
MINIO_BUCKET=ministore-dev

# --- Backend's MinIO credentials (least privilege: only MINIO_BUCKET) ---
# Access key = public identifier (like a username). Secret key = used to sign requests (like a password).
MINIO_APP_ACCESS_KEY=ministore-app
MINIO_APP_SECRET_KEY=change-me-min-8-chars
